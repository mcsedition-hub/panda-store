DJANGO_SECRET_KEY=
# Generated per installation. Store credentials are entered in Connections.
PANDA_CREDENTIAL_KEYS=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=sqlite:///panda.sqlite3
PANDA_DEMO_MODE=true
# First-run organization and owner setup. Bind this alpha to localhost only.
PANDA_SETUP_ENABLED=true
# Legacy seed_demo command only; choose your own account in the setup wizard.
PANDA_DEMO_USERNAME=demo
PANDA_DEMO_PASSWORD=
CELERY_TASK_ALWAYS_EAGER=true
PANDA_WORKFLOW_DISPATCH=database
CELERY_BROKER_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=
